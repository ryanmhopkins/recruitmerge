{
  "name": "recruitmerge",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "build": "npm run build -w @recruitmerge/web && npm run build -w @recruitmerge/extension",
    "dev:web": "npm run dev -w @recruitmerge/web",
    "build:web": "npm run build -w @recruitmerge/web",
    "build:extension": "npm run build -w @recruitmerge/extension"
  }
}
